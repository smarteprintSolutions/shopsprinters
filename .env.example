# Environment Variables for ShopePrinters Next.js Application

# Database
MONGODB_URI=mongodb+srv://[user]:[pass]@cluster0.d6mm1s7.mongodb.net/shopesprinters

# JWT
JWT_SECRET=supersecretkey12345
JWT_EXPIRE_IN=7d

# Email Service (Brevo/Sendinblue)
EMAIL_SERVICE=brevo
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=a60a72001@smtp-brevo.com
EMAIL_PASS=[brevo-api-key]
EMAIL_FROM=no-reply@innovationdynamicsgroup.com
CONTACT_RECEIVER_EMAIL=support@innovationdynamicsgroup.com

# Cloudinary (Image Storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=[name]
CLOUDINARY_API_KEY=[key]
CLOUDINARY_API_SECRET=[secret]

# Clover Payment
NEXT_PUBLIC_CLOVER_PUBLIC_KEY=[key]

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://shopesprinters.com
NEXT_PUBLIC_API_URL=https://shopesprinters.com/api

# Setup Admin
SETUP_ADMIN_USER=admin
SETUP_ADMIN_PASS=[secure-password]

# Environment
NODE_ENV=production
